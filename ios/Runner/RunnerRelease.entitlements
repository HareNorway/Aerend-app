<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:commercial.ailogistics.no</string>
		<!-- Legacy: hare.io links (/invite, /payment/vipps) are no longer generated by any screen.
		     Kept on purpose; Reen Dugnad claims the same domain. -->
		<string>applinks:hare.io</string>
	</array>
	<key>com.apple.developer.in-app-payments</key>
	<array>
		<string>merchant.com.reen.customer</string>
	</array>
</dict>
</plist>
