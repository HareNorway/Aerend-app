<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows a system splash before the launch window: give it the Ærend splash teal and no icon,
         so the hand-over to the Flutter splash (same teal) is one colour, not a blue/white flash. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="Theme.MaterialComponents">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
    </style>
</resources>
